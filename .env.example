# ---------------------------------------------------------------------------
# HMS Node backend — reference for `.env`.
#
# `.env` itself holds the live values and is NOT tracked. This file exists so that
# moving between localhost and the deployed domains is a copy-and-edit, and so the
# four URLs that matter cannot drift apart.
#
#   service                local                     production
#   ---------------------- ------------------------- ---------------------------------
#   this API               http://localhost:3001     https://hms-apinode.anyaman.id
#   HMS frontend           http://localhost:3000     https://hms-node.anyaman.id
#   booking API (Laravel)  http://127.0.0.1:8001     https://booking-apinode.anyaman.id
#   booking frontend       http://localhost:3002     https://booking-node.anyaman.id
#
# The two booking-engine variables point at different services on purpose:
#   BOOKING_ENGINE_URL          -> the Laravel API (dual-write target, status polls)
#   BOOKING_ENGINE_FRONTEND_URL -> the guest-facing Next app (pre-registration links)
# Pointing the second at the API produces links the guest cannot open.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres:@localhost:5432/hms_anyaman?schema=public"

PORT=3001

# This API's own origin. Also the storage root for the action icons returned to
# the reservation screen, so it must resolve to something that serves /storage.
APP_URL=http://localhost:3001

# Where the HMS frontend is served. Used when a booking-side link has to point a
# staff member back at the PMS.
APP_FE_URL=http://localhost:3000

# Booking Engine Laravel API. Local `php artisan serve` is HTTP only, so an
# explicit https:// in this value fails — that is why the host below is 127.0.0.1
# rather than localhost.
BOOKING_ENGINE_URL=http://127.0.0.1:8001

# Guest-facing Booking Engine frontend. The pre-registration link mailed after a
# successful online payment points here; it is not served by the Laravel API.
BOOKING_ENGINE_FRONTEND_URL=http://localhost:3002

# Second connection, read-only by convention. loyalty_rewards /
# reward_redemptions / guest_point_transactions live in MySQL, not Postgres, so
# the Loyalty tabs under Booking Engine Setup read and write this connection.
DB_HMSBOOK_HOST=127.0.0.1
DB_HMSBOOK_PORT=3306
DB_HMSBOOK_DATABASE=draft_hmsbooking
DB_HMSBOOK_USERNAME=
DB_HMSBOOK_PASSWORD=
DB_HMSBOOK_POOL_SIZE=5

# AES-256-CBC envelope key. Must match the booking engine's APP_AES_PASSWORD and
# the HMS frontend's NEXT_PUBLIC_AES_KEY.
APP_AES_PASSWORD=lbwyBzfgzUIvXZFShJuikaWvLJhIVq36

JWT_SECRET=

NODE_ENV=development

# How long a pre-registration link stays valid (days).
PRE_REGISTRATION_TOKEN_TTL_DAYS=30

# STAAH channel manager.
STAAH_BASE_URL=https://connect-sandbox.su-api.com
STAAH_CLIENT_ID=
STAAH_CLIENT_SECRET=
STAAH_AUTH_MODE=basic
STAAH_TIMEOUT=30
STAAH_WEBHOOK_USERNAME=
STAAH_WEBHOOK_PASSWORD=
