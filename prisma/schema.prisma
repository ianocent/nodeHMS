model channel_manager_interfaces {
  id                         BigInt                       @id @default(autoincrement())
  property_id                Int
  hotel_type                 String
  hotel_name                 String
  time_zone                  String                       @default("Asia/Jakarta")
  language_code              String                       @default("en")
  currency_code              String                       @default("IDR")
  hotel_info                 String?                      
  hotel_description          String?                      
  last_sync                  DateTime?
  data                       String?                      
  created_at                 DateTime?
  updated_at                 DateTime?
  deleted_at                 DateTime?
  created_by                 BigInt?                      
  updated_by                 BigInt?                      
  deleted_by                 BigInt?                      
  status                     Int                          @default(0)
  channel_manager_rate_plans channel_manager_rate_plans[]
  channel_manager_room_types channel_manager_room_types[]
}

model channel_manager_rate_plans {
  id                           Int                        @id @default(autoincrement())
  property_id                  BigInt                     
  data                         String?                    
  rate_id                      BigInt                     
  channel_manager_interface_id BigInt
  meal_plan_id                 Int
  last_sync                    DateTime?
