  code_posts     code_posts      @relation(fields: [code_post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bar_inclusives bar_inclusives[]
  bar_rates      bar_rates[]

  @@index([property_id])
  @@index([code_post_id])
}

model bar_inclusives {
  id          BigInt    @id @default(autoincrement())
  property_id BigInt
  bar_id      BigInt
  description String?
  frequency   String?
  cost        String?
  cost_on     String?
  updated_at  DateTime?
  updated_by  BigInt?
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bars        bars       @relation(fields: [bar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([property_id])
  @@index([bar_id])
}

model bar_rates {
  id           BigInt    @id @default(autoincrement())
  property_id  BigInt
  bar_id       BigInt
  room_type_id BigInt
  date         DateTime
  updated_at   DateTime?
  updated_by   BigInt?
  properties   properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bars         bars       @relation(fields: [bar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room_types   room_types @relation(fields: [room_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([property_id])
  @@index([bar_id])
  @@index([room_type_id])
}
