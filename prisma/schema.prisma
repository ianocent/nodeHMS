generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model accountings {
  id                 BigInt         @id @default(autoincrement()) 
  type_accounting    String?
  outstanding        Decimal        @default(0.0000)
  number_note        String?
  type               String?
  date               DateTime       
  doc_date           DateTime       
  code               String?
  type_payment_id    BigInt?        
  transaction_id     BigInt?        
  code_item_id       BigInt?
  company_profile_id BigInt
  description        String?
  amount             Decimal?
  total              Decimal        @default(0.0000)
  pb1                Decimal        @default(0.0000)
  svr_chrg           Decimal        @default(0.0000)
  surcharge          Decimal        @default(0.0000)
  tax3               Decimal        @default(0.0000)
  closing            Decimal        @default(0.0000)
  overwrite_reason   String?
  time               DateTime?      
  bill_to            String?
  model_type         String?
  model_id           BigInt?
  void_code          String?        
  reference          String?
  source             String?
  pos                String?
  receipt            String?
  card_name          String?
  last_digit_card    Int?
  remark             String?        
  voucher            String?
  booking            String?
  property_id        BigInt         
  folio_id           BigInt?        
  is_posting         Int            @default(0) 
  is_endshift        Int            @default(0) 
  is_void            Int            @default(0) 
  is_transfer        Int            @default(0) 
  is_consolidate     Int            @default(0) 
  is_split           Int            @default(0) 
  is_has_inclusive   Int            @default(0) 
  created_at         DateTime?
  updated_at         DateTime?
  deleted_at         DateTime?
  created_by         BigInt?        
  updated_by         BigInt?        
  deleted_by         BigInt?        
  status             Int            @default(0) 
  status_accounting  Int            @default(0) 
  properties         properties     @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folios             folios?        @relation(fields: [folio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type_payments      type_payments? @relation(fields: [type_payment_id], references: [id], onDelete: NoAction, onUpdate: SetNull)

  @@index([folio_id])
  @@index([property_id])
  @@index([type_payment_id])
}

model allocation_accountings {
  id            Int       @id @default(autoincrement())
  date          DateTime  
  unique        String?
  property_id   BigInt
  accounting_id BigInt
  allocated     Decimal
  amount        Decimal
  created_at    DateTime?
  updated_at    DateTime?
  deleted_at    DateTime?
  created_by    BigInt?   
  updated_by    BigInt?   
  deleted_by    BigInt?   
}

model allotments {
  id                BigInt            @id @default(autoincrement()) 
  property_id       BigInt            
  start_date        DateTime          
  end_date          DateTime          
  description       String?           
  release_allotment Int               @default(0)
  model_type        String?
  model_id          BigInt?           
  created_at        DateTime?
  updated_at        DateTime?
  deleted_at        DateTime?
  created_by        BigInt?           
  updated_by        BigInt?           
  deleted_by        BigInt?           
  status            Int               @default(0)
  properties        properties        @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room_allotments   room_allotments[]

  @@index([model_id, model_type])
  @@index([property_id])
}

model auto_transfers {
  id              Int      @id @default(autoincrement())
  property_id     Int
  folio_id        Int
  target_folio_id Int
  date            DateTime @default(now())
}

model baggages {
  id           BigInt     @id @default(autoincrement()) 
  property_id  BigInt     
  date         DateTime   
  name         String?
  tag_no       String?
  remark       String?
  sort         Int        @default(0)
  file         String?
  phone_number String?
  file_path    String?
  created_at   DateTime?
  updated_at   DateTime?
  deleted_at   DateTime?
  created_by   BigInt?    
  updated_by   BigInt?    
  deleted_by   BigInt?    
  status       Int        @default(0)
  properties   properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([property_id])
}

model batch_report {
  id          BigInt    @id @default(autoincrement()) 
  property_id BigInt?   
  batch_list  String?   
  created_at  DateTime?
  updated_at  DateTime?
  deleted_at  DateTime?
  created_by  BigInt?   
  updated_by  BigInt?   
  deleted_by  BigInt?   
  status      Int?      @default(0)
  batch_name  String?

  @@index([property_id])
}

model billing_tos {
  id            BigInt        @id @default(autoincrement()) 
  property_id   BigInt        
  folio_id      BigInt        
  billing_code  BigInt        
  model_type    String
  model_id      BigInt        
  created_at    DateTime?
  updated_at    DateTime?
  deleted_at    DateTime?
  created_by    BigInt?       
  updated_by    BigInt?       
  deleted_by    BigInt?       
  properties    properties    @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folios        folios        @relation(fields: [folio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  code_billings code_billings @relation(fields: [billing_code], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([billing_code])
  @@index([folio_id])
  @@index([model_id, model_type])
  @@index([property_id])
}

model cancelation_rule_dates {
  id                  BigInt            @id @default(autoincrement()) 
  property_id         BigInt            
  uuid                String
  cancelation_rule_id BigInt            
  start_date          DateTime          
  end_date            DateTime          
  created_at          DateTime          @default(now())
  updated_at          DateTime          @default(now())
  deleted_at          DateTime?
  created_by          BigInt?           
  updated_by          BigInt?           
  deleted_by          BigInt?           
  status              Int?              @default(0)
  cancelation_rules   cancelation_rules @relation(fields: [cancelation_rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cancelation_rule_id])
}

model cancelation_rules {
  id                     BigInt                   @id @default(autoincrement()) 
  property_id            BigInt                   
  uuid                   String
  room_type_id           BigInt                   
  code                   String
  description            String?                  
  type_date              String
  type_refund            String?
  value                  Decimal                  @default(0.00)
  value_days             Int                      @default(0)
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @default(now())
  deleted_at             DateTime?
  created_by             BigInt?                  
  updated_by             BigInt?                  
  deleted_by             BigInt?                  
  status                 Int?                     @default(0)
  cancelation_rule_dates cancelation_rule_dates[]
}

model car_parks {
  id           BigInt     @id @default(autoincrement()) 
