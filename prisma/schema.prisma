  rates                        rates                      @relation(fields: [rate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel_manager_interfaces   channel_manager_interfaces @relation(fields: [channel_manager_interface_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([channel_manager_interface_id])
  @@index([property_id])
  @@index([rate_id])
}

model channel_manager_room_types {
  id                                                             Int                        @id @default(autoincrement())
  property_id                                                    Int
  channel_manager_interface_id                                   BigInt
  data                                                           String?                    
  last_sync                                                      DateTime?
  room_type_id                                                   BigInt                     
  max_occupancy                                                  Int
  max_child_occupancy                                            Int
  quantity                                                       Int
  room_type                                                      BigInt                     
  size_measurement                                               Float                      
  size_measurement_unit                                          String
  latitude                                                       Decimal?
  longitude                                                      Decimal?
  address_line                                                   String?
  city_name                                                      String?
  country_name                                                   String?
  postal_code                                                    String?
  description                                                    String?                    
  room_description                                               String?                    
  created_at                                                     DateTime?
  updated_at                                                     DateTime?
  deleted_at                                                     DateTime?
  created_by                                                     BigInt?                    
  updated_by                                                     BigInt?                    
  deleted_by                                                     BigInt?                    
  status                                                         Int                        @default(0)
  room_types_channel_manager_room_types_room_type_idToroom_types room_types                 @relation("channel_manager_room_types_room_type_idToroom_types", fields: [room_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room_types_channel_manager_room_types_room_typeToroom_types    room_types                 @relation("channel_manager_room_types_room_typeToroom_types", fields: [room_type], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel_manager_interfaces                                     channel_manager_interfaces @relation(fields: [channel_manager_interface_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([channel_manager_interface_id])
  @@index([room_type])
  @@index([room_type_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cities {
  id                          BigInt                        @id @default(autoincrement()) 
  name                        String
  state_id                    BigInt?                       
  state_code                  String?
  country_id                  BigInt                        
  country_code                String?
  latitude                    Decimal?
  longitude                   Decimal?
  created_at                  DateTime?
  updated_at                  DateTime?
  flag                        Boolean                       @default(true)
  status                      Boolean                       @default(true)
  wikiDataId                  String?
  states                      states?                       @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  countries                   countries                     @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company_profile_departments company_profile_departments[]
  properties                  properties[]

  @@index([state_id])
  @@index([country_id])
}

