<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guest Folio</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.3;
            text-transform: uppercase;
        }

        thead { display: table-header-group; }
        tfoot { display: table-footer-group; }
        tr { page-break-inside: avoid; }
      
        .header {
            text-align: left;
            margin-bottom: 30px;
            width: 100%;
        }
        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }
        .logo-container {
            height: 80px;
            width: auto;
            display: flex;
            align-items: center;
        }
        .logo {
            width: 315px;
            height: auto;
        }
        .title {
            font-size: 24px;
            font-weight: bold;
            text-align: right;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 5px;
            text-align: left;
        }
        .no-border {
            border: none;
        }
        .text-right {
            text-align: right;
        }
        .footer {
            margin-top: 20px;
        }
        
        main { text-transform: uppercase; }
    </style>
</head>
<body>

    <div class="header">
        <div class="header-container">
            <div class="logo-container">
                <img src="data:image/png;base64,<%= logoBase64 %>" alt="Logo Company" class="logo">
            <!-- <img src="<%= logoBase64 %>" alt="Hotels Logo" class="logo "> -->
            </div>
            <div class="title">GUEST FOLIO</div>
        </div>
    </div>

    <table class="no-border">
        <tr>
            <td><strong>Please Make payable to</strong></td>
            <td></td>
            <td></td>
            <td class="text-right">Page 1 of 1</td>
        </tr>
        <tr>
            <td>Company</td>
            <td>: <%= billTo %></td>
            <td>Guest</td>
            <td>: <%= guest %></td>
        </tr>
        <tr>
            <td>Tel</td>
            <td>: <%= tel %></td>
            <td>Folio No.</td>
            <td>: <%= folioNo %></td>
        </tr>
        <tr>
            <td>Number Of Person</td>
            <td>: <%= numberOfPerson %></td>
            <td>Arrival</td>
            <td>: <%= arrival %></td>
        </tr>
        <tr>
            <td>Voucher No</td>
            <td>: <%= voucherNo %></td>
            <td>Departure</td>
            <td>: <%= departure %></td>
        </tr>
        <tr>
            <td>Email</td>
            <td>: <%= email %></td>
            <td>Room</td>
            <td>: <%= room %></td>
        </tr>
    </table>

    <table style="margin-top: 20px;">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th class="text-right">Debet</th>
                <th class="text-right">Credit</th>
            </tr>
        </thead>
        <tbody>
            <%
                let totalDebit = 0;
                let totalCredit = 0;
            %>
            <% transactions.forEach(function(transaction) { %>
                <%
                    if(transaction.debit) {
                        totalDebit += parseFloat(transaction.debit.toString().replace(/,/g, ''));
                    }
                    if(transaction.credit) {
                        totalCredit += parseFloat(transaction.credit.toString().replace(/,/g, ''));
                    }
                %>
                <tr>
                    <td><%= transaction.date %></td>
                    <td><%= transaction.description %></td>
                    <td class="text-right"><%= transaction.debit %></td>
                    <td class="text-right"><%= transaction.credit %></td>
                </tr>
            <% }); %>
            <!-- Total row -->
            <tr>
                <td colspan="2" class="text-right"><strong>TOTAL</strong></td>
                <td class="text-right"><strong><%= totalDebit.toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong></td>
                <td class="text-right"><strong><%= totalCredit.toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong></td>
            </tr>
        </tbody>
    </table>

    <table class="no-border" style="margin-top: 20px;">
        <tr>
            <td colspan="2"></td>
            <td>TOTAL AMOUNT include 21% Service Charge & GST:</td>
            <td class="text-right"><%= (totalDebit - totalCredit).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
        </tr>
        <tr>
            <td colspan="2"></td>
            <td><strong>BALANCE</strong></td>
            <td class="text-right"><strong><%= (totalDebit - totalCredit).toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong></td>
        </tr>
    </table>

    <div class="footer">
        <p>"I HEREBY AGREE THAT MY LIABILITY FOR THIS BILL IS NOT WAIVED<br>
        AND THAT I WILL BE HELD PERSONALLY<br>
        RESPONSIBLE IN THE EVENT THAT THE INDICATED PERSON,<br>
        COMPANY OR ASSOCIATION FAILS TO PAY FOR ANY PART OR<br>
        THE FULL AMOUNT OF INCURRED CHARGES"</p>

        <table class="no-border">
            <tr>
                <td>
                    <div style="border-top: 1px solid black; width: 200px; margin-top: 50px;">
                        <%= billTo %><br>
                        Guest/Company
                    </div>
                </td>
                <td class="text-right">
                    <div style="border-top: 1px solid black; width: 200px; margin-top: 50px; float: right;">
                        Reception
                    </div>
                </td>
            </tr>
        </table>
    </div>

    <div style="margin-top: 20px; font-size: 10px; text-align: center;">
        <%= hotelName %><br>
        <!-- Bangka Raya Street 7A, Kemang, South Jakarta 12730<br> -->
        <%= address %><br>
        <%= phone %><br>
        <%= email %>
        <!-- Phone : +6221 2271 5111  Fax : +6221 2271 7515 Website : www.kuretakesoindonesia.com<br> -->
        <!-- email: reservation-kemang@kuretake-inn.com -->
    </div>

    <div style="position: absolute; bottom: 0; right: 0; font-size: 10px;">
        Printed on: <%= new Date().toLocaleString('en-GB') %>
    </div>
</body>
</html>