<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pre Registration</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 8px;
            line-height: 1.3;
            text-transform: uppercase; 
        }
        thead { display: table-header-group; }
        tfoot { display: table-footer-group; }
        tr { page-break-inside: avoid; }

        .header {
            text-align: left;
            margin-bottom: 20px;
            width: 100%;
        }
        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }
        .manager-info {
            flex: 1;
        }
        .logo-container {
            height: 80px;
            width: auto;
            display: flex;
            align-items: center;
        }
        .logo {
            width: 315px;
            height: auto;
        }
        .title {
            text-align: right;
            font-size: 12px;
            font-weight: bold;
            color: #8B4513;
            margin-bottom: 10px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        .table-no-border, .table-no-border th, .table-no-border td {
            border: none;
        }
        th, td {
            padding: 5px;
            text-align: left;
        }
        .no-border {
            border: none;
        }
        .checkbox {
            width: 15px;
            height: 15px;
            border: 1px solid black;
            display: inline-block;
            margin-right: 5px;
        }
        .footer {
            font-size: 8px;
            margin-top: 10px;
        }
        .black-bg {
            background-color: black;
            color: white;
            text-align: center;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <% hotel = strtolower(trim(hotelName)); %>

    @switch($hotel)
        @case('kuretakeso')
            <%= -- ========================== -- %>
            <%= -- KURETAKESO LAYOUT -- %>
            <%= -- ========================== -- %>
            @include('modules.cms.pdf.batch.folio.partials.pre-registration-kuretakeso')
            @break

        @case('bali bagus')
            <%= -- ========================== -- %>
            <%= -- BALI BAGUS LAYOUT -- %>
            <%= -- ========================== -- %>
            @include('modules.cms.pdf.batch.folio.partials.pre-registration-bali-bagus')
            @break

        @case('olive')
            <%= -- ========================== -- %>
            <%= -- OLIVE LAYOUT -- %>
            <%= -- ========================== -- %>
            @include('modules.cms.pdf.batch.folio.partials.pre-registration-olive')
            @break

        @default
            <%= -- ========================== -- %>
            <%= -- ANYAMAN (DEFAULT) -- %>
            <%= -- ========================== -- %>
            @include('modules.cms.pdf.batch.folio.partials.pre-registration-anyaman')
    @endswitch
</body>

