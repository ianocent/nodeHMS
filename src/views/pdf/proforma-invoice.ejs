<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proforma Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.3;
            text-transform: uppercase; 
        }
        thead { display: table-header-group; }
        tfoot { display: table-footer-group; }
        tr { page-break-inside: avoid; }

        .header {
            text-align: left;
            margin-bottom: 20px;
        }
        .header img {
            max-width: 200px;
        }
        .title {
            font-size: 18px;
            font-weight: bold;
            text-align: right;
            margin: 20px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 5px;
            text-align: left;
        }
        .no-border {
            border: none;
        }
        .text-right {
            text-align: right;
        }
        .footer {
            margin-top: 20px;
            font-size: 10px;
        }
        .logo {
            width: 315px;
            height: auto;
        }
    </style>
</head>
<body>
    <div class="header">
        <!-- <img src="<%= public_path('images/property.png') %>" alt="Hotel Kuretakeso Logo" class="logo"> -.
        <!-- <img src="<%= logoBase64 %>" alt="Hotels Logo" class="logo "> -.
        <img src="data:image/png;base64,<%= logoBase64 %>" alt="Logo Company" class="logo">
    </div>

    <div class="title">PROFORMA INVOICE</div>

    <table class="no-border">
        <tr>
            <td style="width: 60%;">
                <strong><%= guestName %></strong><br>
                <%= company %><br>
                <%= address %>
            </td>
            <td style="width: 40%;">
                <table>
                    <tr>
                        <td><strong>Folio Number :</strong></td>
                        <td><%= folioNumber %></td>
                    </tr>
                    <tr>
                        <td><strong>Room No :</strong></td>
                        <td><%= roomNo %></td>
                    </tr>
                    <tr>
                        <td><strong>Room Type :</strong></td>
                        <td><%= roomType %></td>
                    </tr>
                    <tr>
                        <td><strong>Check In Date :</strong></td>
                        <td><%= checkInDate %></td>
                    </tr>
                    <tr>
                        <td><strong>Check Out Date :</strong></td>
                        <td><%= checkOutDate %></td>
                    </tr>
                    <tr>
                        <td><strong>No. Of Adults :</strong></td>
                        <td><%= noOfAdults %></td>
                    </tr>
                    <tr>
                        <td><strong>No. Of Child :</strong></td>
                        <td><%= noOfChild %></td>
                    </tr>
                    <tr>
                        <td><strong>Voucher Number :</strong></td>
                        <td><%= voucherNumber %></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table style="margin-top: 20px;">
        <thead>
            <tr>
                <th>DATE</th>
                <th>DESCRIPTION</th>
                <th class="text-right">AMOUNT IDR</th>
            </tr>
        </thead>
        <tbody>
            <% transactions.forEach(function(transaction) { %>
            <tr>
                <td><%= new Date(transaction.date).toLocaleDateString('en-GB') %></td>
                <td><%= transaction.codePost.name %></td>
                <td class="text-right"><%= (parseFloat(transaction.total) || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
            </tr>
            <% }); %>
        </tbody>
    </table>

    <table class="no-border" style="margin-top: 20px;">
        <tr>
            <td style="width: 50%;">
                <strong>TOTAL AMOUNT :</strong>
            </td>
            <td class="text-right width: 50%;">
                <strong>IDR <%= (totalAmountGuest).toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong>
            </td>
        </tr>
    </table>
    <table class="no-border" style="margin-top: 20px;">
        <tr>
            <td style="width: 50%;">
                <strong>TOTAL AMOUNT BALANCE :</strong>
            </td>
            <td class="text-right width: 50%;">
                <strong>IDR <%= (totalAmount).toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong>
            </td>
        </tr>
    </table>

    <table class="no-border" style="margin-top: 20px;">
        <tr>
            <td style="width: 60%;">
                <strong><%= guestName %></strong><br>
                <%= company %><br>
                <%= address %>
            </td>
            <td style="width: 40%;">
                <strong>Guest Signature :</strong><br>
                <div style="border-top: 1px solid black; margin-top: 50px;"></div>
            </td>
        </tr>
    </table>

    <div class="footer">
        <p>I agree that my liability for this account is not waived and agree to be personally responsible in the event that the indicated person,
        company or association fails to pay for any part or the full amount of these charges.</p>
        <p>Unless otherwise specified in this invoice, the date of issue is the date of departure.</p>
        <!-- <p>Hotel Kuretakeso Kemang Jakarta<br> -.
        <%= hotelName %><br>
        <%= propertyAddress %><br>
        <!-- Bangka Raya Street 7A, Kemang, South Jakarta 12730<br> -.
        <!-- Phone : +6221 2271 5111  Fax : +6221 2271 7515 Website : www.kuretakesoindonesia.com</p> -.
         <%= phone %>
    </div>
</body>
</html>